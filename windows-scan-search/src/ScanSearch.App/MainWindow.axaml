<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScanSearch.App.ViewModels"
        xmlns:conv="using:ScanSearch.App.Converters"
        x:Class="ScanSearch.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ScanSearch — Pesquisa de documentos digitalizados"
        Width="1180" Height="760" MinWidth="820" MinHeight="560">

  <DockPanel Margin="12">

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
      <Button Content="Importar pasta..." Click="OnImportFolderClick" />
      <Button Content="Cancelar" Command="{Binding CancelImportCommand}" IsVisible="{Binding IsIndexing}" />
      <TextBlock Text="{Binding ImportedFolderPath}" VerticalAlignment="Center" Foreground="Gray"
                 TextTrimming="CharacterEllipsis" MaxWidth="420" />
      <TextBlock Text="{Binding IndexCountText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Foreground="Gray" Margin="24,0,0,0" />
    </StackPanel>

    <!-- OCR language setup -->
    <Expander DockPanel.Dock="Top" Header="Idiomas de OCR" Margin="0,0,0,8"
              IsExpanded="{Binding !HasAnyLanguageInstalled}">
      <ItemsControl ItemsSource="{Binding Languages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LanguageViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4">
              <TextBlock Text="{Binding DisplayName}" Width="100" VerticalAlignment="Center" />
              <TextBlock Text="Instalado" Foreground="Green" IsVisible="{Binding IsInstalled}"
                         VerticalAlignment="Center" />
              <Button Content="Descarregar" Command="{Binding DownloadCommand}"
                      IsVisible="{Binding !IsInstalled}" IsEnabled="{Binding !IsDownloading}" />
              <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Width="140"
                           IsVisible="{Binding IsDownloading}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <!-- Indexing progress -->
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8" IsVisible="{Binding IsIndexing}">
      <ProgressBar Value="{Binding IndexingProgressPercent}" Minimum="0" Maximum="100" />
      <TextBlock Text="{Binding IndexingStatusText}" Foreground="Gray" FontSize="12" />
    </StackPanel>

    <!-- Status bar -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,8,0,0" />

    <!-- Search box -->
    <TextBox DockPanel.Dock="Top" PlaceholderText="Pesquisar por conteúdo ou nome do ficheiro..."
             Text="{Binding SearchQuery}" Margin="0,0,0,8" FontSize="16" Padding="10,8" />

    <!-- Content: results + preview -->
    <Grid ColumnDefinitions="2.1*,10,3*">

      <ListBox Grid.Column="0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentResultViewModel">
            <StackPanel Margin="2,6">
              <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding FolderPath}" Foreground="Gray" FontSize="11"
                         TextTrimming="CharacterEllipsis" />
              <ItemsControl ItemsSource="{Binding SnippetSegments}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SnippetSegment">
                    <TextBlock Text="{Binding Text}" FontSize="12"
                               FontWeight="{Binding IsMatch, Converter={x:Static conv:MatchToFontWeightConverter.Instance}}"
                               Foreground="{Binding IsMatch, Converter={x:Static conv:MatchToBrushConverter.Instance}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="Gray" />
                <TextBlock Text="{Binding SizeInfo}" FontSize="11" Foreground="Gray" />
                <TextBlock Text="{Binding LastModifiedInfo}" FontSize="11" Foreground="Gray" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                    IsVisible="{Binding SelectedResult, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Button Content="Abrir" Click="OnOpenClick" />
          <Button Content="Descarregar (guardar cópia)" Click="OnSaveAsClick" />
          <Button Content="Mostrar na pasta" Click="OnRevealClick" />
        </StackPanel>

        <Border Background="#181818" CornerRadius="4">
          <Grid>
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8" />
            <TextBlock Text="Sem pré-visualização" Foreground="Gray" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}" />
          </Grid>
        </Border>
      </DockPanel>

    </Grid>

  </DockPanel>

</Window>
